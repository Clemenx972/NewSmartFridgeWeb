# ─── Copie ce fichier en .env.local et renseigne les valeurs ────────────────
# .env.local est ignoré par git — n'y mets jamais de secret dans un fichier suivi.

# Envoi des emails du formulaire de contact.
# Sans cette clé, le formulaire accepte les messages mais ne les envoie pas
# (dégradation volontaire, pratique en développement local).
# Obtenir une clé : https://resend.com/api-keys
RESEND_API_KEY=

# ─── Optionnel — à activer plus tard ────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# STRIPE_SECRET_KEY=
